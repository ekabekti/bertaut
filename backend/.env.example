# contoh — salin menjadi `.env` bila perlu (opsional, semua ada bawaannya)
PORT=3000
BERTAUT_ADMIN_USER=admin
BERTAUT_ADMIN_PASS=ganti-dengan-sandi-kuat
BERTAUT_DATA_DIR=
TOKEN_TTL_HOURS=12

# --- SSO Keycloak (OIDC) — hibrida: login lokal tetap + tombol SSO ---
# Issuer realm Keycloak, cth. http://localhost:8080/realms/bertaut
# Kosongkan untuk menonaktifkan SSO.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=bertaut
# Isi bila client bersifat confidential (Access Type). Kosongkan bila public.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/sso/callback
KEYCLOAK_SCOPES=openid profile email
# Daftar role (realm atau client) yang boleh Kelola, dipisah koma.
BERTAUT_ADMIN_ROLES=bertaut-admin,admin
