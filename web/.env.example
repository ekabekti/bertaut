# Lokal (SQLite file) — tanpa TURSO_* maka pakai file ini
DATABASE_FILE=./data/bertaut.db
AUTH_SECRET=ganti-dengan-string-acak-panjang-min-32
TOKEN_TTL_HOURS=12
BERTAUT_ADMIN_USER=admin
BERTAUT_ADMIN_PASS=ganti-dengan-sandi-kuat

# SSO Keycloak (opsional — kosongkan untuk mati)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=bertaut
KEYCLOAK_CLIENT_SECRET=
# Kosongkan agar otomatis <origin>/api/auth/sso/callback (disarankan di Vercel)
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_SCOPES=openid profile email
BERTAUT_ADMIN_ROLES=bertaut-admin,admin

# Produksi Vercel + Turso (SQLite remote, persisten)
# TURSO_DATABASE_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=xxxx
